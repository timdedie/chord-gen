# ---- Required ----

# DeepSeek Chat, the primary model used for generation.
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Clerk handles auth. ClerkProvider wraps the whole app in app/layout.tsx,
# so the app will not boot without these.
# https://dashboard.clerk.com -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres. lib/db/index.ts creates the client at module load and
# /api/generate-multiple imports it, so generation fails without this.
# Any Postgres URL that neon-http accepts will do.
# https://console.neon.tech
DATABASE_URL=

# ---- Optional ----

# Enables a Gemini fallback model. Without it, DeepSeek is the only model.
GOOGLE_GENERATIVE_AI_API_KEY=

# PostHog analytics. Everything no-ops cleanly when unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
